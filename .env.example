# Hard stop. New previews are refused once this many are live.
MAX_CONCURRENT_ENVIRONMENTS=10

# A preview expires this many hours after it was created or last updated (a new commit resets the clock).
PREVIEW_TTL_HOURS=168

# Extending a preview can never push its expiry past this many hours after it was created.
PREVIEW_MAX_LIFETIME_HOURS=168

# Assumed cost of one preview container running for an hour, for the board's savings estimate.
PREVIEW_COST_PER_HOUR=0.05

# Currency symbol shown with estimated savings on the board. Default "$".
PREVIEW_CURRENCY=$

# Reference window for the board's 'Mark idle' button. The reaper no longer deletes idle previews;
# an idle preview is slept by its gate (the app process exits, the gate stays up) and wakes on the next visit.
PREVIEW_IDLE_HOURS=4

# Stop the preview app after this many seconds without a request. The next request wakes it.
PREVIEW_SLEEP_SECONDS=20

# Optional per-repository idle seconds. Format: owner/name=60,other/repo=300
# Repos not listed use PREVIEW_SLEEP_SECONDS. Invalid entries are ignored with a startup warning.
# PREVIEW_SLEEP_RULES=

# Optional demo knob. Delays the preview app listening by this many milliseconds after it is started,
# so the "Waking up" page has something to show. This delay is simulated and is not a real cold start.
PREVIEW_BOOT_DELAY_MS=0

# Mark provisioning, updating, or destroying previews as stuck after this many minutes.
PREVIEW_STUCK_MINUTES=10

# How often the in-process reaper checks for expired and stuck previews.
REAPER_INTERVAL_MS=60000

# process starts one Node server per pull request. fake only writes a local record.
DEPLOYER=process
# process runs the preview app as plain Node. docker runs it in a container. Compose sets docker.
PREVIEW_RUNTIME=process

# Limits for each preview container (docker only). Memory is 128m to 2g. CPUs is 0.1 to 4. Bad values use these defaults.
PREVIEW_MEMORY=256m
PREVIEW_CPUS=0.5

# Docker runtime only. Comma-separated owner/name list of repositories whose pull requests are built from their
# own Dockerfile and run in a container. Any other repository fails with "Repository not allowed"; the demo keeps
# the placeholder app. Pull requests from forks are never built.
# Example: PREVIEW_REPOS=meetamadhu/mayfly-sample-app
PREVIEW_REPOS=
# When a repository has no Dockerfile, Mayfly writes one if it recognises the app (Next.js, Vite, React, Vue,
# Angular, Node with a start script, plain HTML, Flask, FastAPI). Set to false to require a Dockerfile.
# PREVIEW_AUTO_DOCKERFILE=true

# Limits on building pull requests (docker runtime). A bad value uses the default shown.
# Builds that run at once, 1 to 8. Others wait their turn.
PREVIEW_MAX_BUILDS=1
# Memory (swap included) and CPUs for each build step. 256m to 4g, and 0.25 to 4.
PREVIEW_BUILD_MEMORY=1g
PREVIEW_BUILD_CPUS=1
# Largest clone plus build context, and largest built image, in MB. A build over either limit fails.
PREVIEW_MAX_REPO_MB=200
PREVIEW_MAX_IMAGE_MB=1024

# Artificial delay for the fake deployer so the board can show in-progress states.
PREVIEW_FAKE_DELAY_MS=700

# Optional. MongoDB connection string (for example MongoDB Atlas). When set, the list of previews and the
# monthly savings totals are stored in MongoDB (database "mayfly") instead of data/state.json.
# Leave empty to keep the local JSON file. Only one running Mayfly should use a given database.
# Example: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Openable origin for preview links. Defaults to this app on localhost.
# Leave this empty on GitHub Codespaces. Mayfly uses the codespace address for port 3000.
PREVIEW_BASE_URL=http://localhost:3000

# Required in production. In development, unsigned webhook deliveries are accepted when this is empty.
GITHUB_WEBHOOK_SECRET=

# Optional. Fine-grained: Contents read + Pull requests read/write + Commit statuses write
# (or classic repo / repo:status). Posts a "Mayfly — Preview" check and a PR comment.
# Put the token in .env.local — Docker Compose does not pass Codespace secrets into the container.
# Repo/Codespaces secret names cannot start with GITHUB_; MAYFLY_GITHUB_TOKEN is accepted too.
GITHUB_TOKEN=
# MAYFLY_GITHUB_TOKEN=

# Required. Protects the actions that change things: POST /api/environments/<id>?action=destroy|sleep|activity|extend|keep_awake|keep_awake_off,
# POST /api/reaper, and POST /api/events. Scripts send `Authorization: Bearer <token>` or `x-mayfly-admin: <token>`.
# People enter it once on /admin/login. When empty, those actions are always refused.
# Generate one with: openssl rand -hex 32. Keep it server-side: never a NEXT_PUBLIC_ variable.
MAYFLY_ADMIN_TOKEN=

# Optional. Keep this preview alive so a visitor can open it without the admin token.
# Quote the value. A bare # starts a comment, so acme/web#1 is read as acme/web.
# Example: DEMO_PREVIEW="acme/web#1"
# Empty turns it off. The branch is demo and the commit is d3m0d3m0.
DEMO_PREVIEW=

# Set to true to allow the admin simulator (Open PR, Push commit…) when NODE_ENV=production.
ALLOW_SIMULATOR=

# Optional. Incoming webhook URL of a chat channel (Slack, Discord, Google Chat, Mattermost…). Mayfly posts there
# when a build fails, a preview gets stuck, the disk runs low, Docker stops answering, the clean-up loop fails,
# and when Mayfly starts. Empty means alerts are only written to the log. Treat the URL like a password.
ALERT_WEBHOOK_URL=

# Alert when free disk space drops below this percentage. 1 to 50. Default 15.
ALERT_DISK_PERCENT=15

# Optional. Group repositories into teams for the Cost page's "by team" report.
# Example: PREVIEW_TEAMS=web=acme/site,acme/shop;platform=acme/infra-*
PREVIEW_TEAMS=

# Optional. Weekly cost summary by email. Needs SMTP_URL and at least one address in REPORT_EMAIL_TO.
# smtp://user:password@smtp.example.com:587   or   smtps://user:password@smtp.example.com:465
SMTP_URL=
# From address, for example: Mayfly <mayfly@yourcompany.com>
REPORT_EMAIL_FROM=
REPORT_EMAIL_TO=
# Day of week (1 = Monday … 7 = Sunday) and hour in UTC. Defaults: Monday 09:00 UTC.
REPORT_WEEKDAY=1
REPORT_HOUR_UTC=9

# Optional. Per-preview sandbox databases (Postgres or MongoDB), configured per repository under Preview settings.
# Admin URL of a dedicated server Mayfly can create databases on. Treat like a password.
# PREVIEW_DB_POSTGRES_URL=postgres://mayfly_admin:…@db.example.com:5432/postgres
# PREVIEW_DB_MONGO_URL=mongodb://mayfly_admin:…@db.example.com:27017/?authSource=admin
# Host the preview apps should use in the connection string (defaults to the admin URL's host).
# PREVIEW_DB_APP_HOST=
# Derives each preview's database password. Required when sandbox databases are turned on.
# MAYFLY_SECRETS_KEY=

# Optional. Path to Chrome, Chromium or Edge for screenshot comparisons against production.
# Leave empty to let Mayfly look in the usual places.
# PREVIEW_CHROME_PATH=

# Optional. Name this Mayfly host when you run more than one (shown on Health & ops).
# MAYFLY_INSTANCE=aws-east-1

# Optional. Footer social icons on the home page (icons only). GitHub defaults to the Mayfly repo.
# NEXT_PUBLIC_SOCIAL_GITHUB=https://github.com/Meetamadhu/mayfly
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/in/…
# NEXT_PUBLIC_SOCIAL_X=https://x.com/…

# Daily backups of the saved state (preview records, usage, lifetime rules) are written to data/backups.
# How many to keep, 1 to 90. Default 7. Restore with deploy/aws/backup.sh, or node dist/restore.js when stopped.
BACKUP_KEEP=7

# Optional. Razorpay, for adding prepaid Pay as you go credit on the Pricing page. Without these, pricing stays a
# demo and credit isn't needed. Use TEST keys (rzp_test_…): test UPI (success@razorpay) and test cards, no real
# money. Live keys (rzp_live_…) are refused unless RAZORPAY_ALLOW_LIVE=true. Treat the secrets like passwords.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: the secret you set on a Razorpay webhook pointing at https://<your Mayfly>/api/webhooks/razorpay
# (events order.paid and payment.captured). It adds credit even if someone closes the tab mid-payment.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ALLOW_LIVE=
