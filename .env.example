# Hard stop. New previews are refused once this many are live.
MAX_CONCURRENT_ENVIRONMENTS=10

# Maximum lifetime of a preview, in hours. A new commit resets this clock.
PREVIEW_TTL_HOURS=168

# Reference window for the board's 'Mark idle' button. The reaper no longer deletes idle previews;
# an idle preview is slept by its gate (the app process exits, the gate stays up) and wakes on the next visit.
PREVIEW_IDLE_HOURS=4

# Stop the preview app after this many seconds without a request. The next request wakes it.
PREVIEW_SLEEP_SECONDS=20

# Optional demo knob. Delays the preview app listening by this many milliseconds after it is started,
# so the "Waking up" page has something to show. This delay is simulated and is not a real cold start.
PREVIEW_BOOT_DELAY_MS=0

# Mark provisioning, updating, or destroying previews as stuck after this many minutes.
PREVIEW_STUCK_MINUTES=10

# How often the in-process reaper checks for expired and stuck previews.
REAPER_INTERVAL_MS=60000

# process starts one Node server per pull request. fake only writes a local record.
DEPLOYER=process

# Artificial delay for the fake deployer so the board can show in-progress states.
PREVIEW_FAKE_DELAY_MS=700

# Openable origin for preview links. Defaults to this app on localhost.
PREVIEW_BASE_URL=http://localhost:3000

# Required in production. In development, unsigned webhook deliveries are accepted when this is empty.
GITHUB_WEBHOOK_SECRET=

# Optional. When set, preview comments are also posted on the pull request.
GITHUB_TOKEN=

# Required. Protects the actions that change things: POST /api/environments/<id>?action=destroy|idle|activity,
# POST /api/reaper, and POST /api/events. Send `Authorization: Bearer <token>` or `x-mayfly-admin: <token>`,
# or paste it into the board's Admin token field. When empty, those actions are always refused.
# Generate one with: openssl rand -hex 32. Keep it server-side: never a NEXT_PUBLIC_ variable.
MAYFLY_ADMIN_TOKEN=

# Optional. Keep this preview alive so a visitor can open it without the admin token.
# Quote the value. A bare # starts a comment, so acme/web#1 is read as acme/web.
# Example: DEMO_PREVIEW="acme/web#1"
# Empty turns it off. The branch is demo and the commit is d3m0d3m0.
DEMO_PREVIEW=
