{
  "name": "mayfly",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "build": "next build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.js --alias:@=./src",
    "start": "node dist/server.js",
    "test": "node scripts/test-ttl-policies.mjs && node scripts/test-sleep-policy.mjs && node scripts/test-usage-cost.mjs && node scripts/test-pr-comment-upsert.mjs && tsx scripts/test-fleet.ts && tsx scripts/test-prune.ts && tsx scripts/test-alerts.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongodb": "^6.21.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
